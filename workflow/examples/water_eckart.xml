    <forces>
      <force forcefield="et-cbohf" />
    </forces>
    <motion mode="constrained_dynamics">
      <fixcom>false</fixcom>
      <constrained_dynamics mode="nve">
        <timestep units="femtosecond">0.1</timestep>
        <nsteps_geo>5</nsteps_geo>
        <csolver>
          <tolerance>1e-10</tolerance>
          <maxit>1000</maxit>
          <norm_order>2</norm_order>
